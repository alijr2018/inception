FROM debian:bookworm

# RUN apt update -y   && apt install mariadb-server -y
# RUN mean Executes a command while building the image.
RUN apt update -y && apt install curl wget php8.2 php8.2-mysql php8.2-fpm mariadb-client -y


RUN curl -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar &&  chmod +x wp-cli.phar &&  mv wp-cli.phar /usr/local/bin/wp


RUN sed -i 's|^listen = .*|listen = 0.0.0.0:9000|' /etc/php/8.2/fpm/pool.d/www.conf
# you could change this to just other way

# RUN mkdir -p /run/mysqld && chown -R mysql:mysql /run/mysqld && chown 755 /var/run/mysqld
# COPY conf/mariadb.cnf /etc/mysql/mariadb.conf.d/50-server.cnf
WORKDIR /var/www/html
#in the config i could use the default one generated by nginx
# COPY ./conf/nginx.conf /etc/nginx/conf.d/default.conf
COPY ./conf/word.sh /

# RUN chmod +x /usr/local/bin/mariadb.sh
RUN chmod +x /word.sh

# EXPOSE 9000

# seach more about healtcheck
# HEALTHCHECK --interval=30s --timeout=30s  --retries=3 CMD [ "mariadb-admin", "ping", "-h", "localhost" ]

# CMD ["nginx","-g", "deamon off;"]
# ENTRYPOINT ["nginx","-g", "daemon off;"]

ENTRYPOINT [ "/word.sh" ]
CMD [ "php-fpm8.2", "-F" ]
# ENTRYPOINT ["/usr/local/bin/mariadb.sh"]